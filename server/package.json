{
  "name": "server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "setup:dict": "tsx scripts/build-jmdict.ts && tsx scripts/build-zhdict.ts && tsx scripts/pack-dict.ts",
    "pack:dict": "tsx scripts/pack-dict.ts",
    "setup:dict:zh": "tsx scripts/build-zhdict.ts"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "express": "^5.3.0",
    "kuromoji": "^0.1.2",
    "node-edge-tts": "^1.2.12",
    "opencc-js": "^1.4.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/kuromoji": "^0.1.3",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
